<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础主题，供整个应用使用 -->
    <style name="Base.Theme.TaskKillTest" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 定制你的主题颜色 -->
        <item name="colorOnPrimary">@color/black</item>
        <!-- 次要品牌色 -->
        <item name="colorSecondary">@color/translucent_200</item>
        <item name="colorSecondaryVariant">@color/translucent_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- 关键：设置全屏，隐藏状态栏 -->
        <item name="android:windowFullscreen">true</item>
        <!-- 禁止系统装饰（如状态栏）的半透明效果，实现更纯粹的全屏 -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- 最终使用的主题，继承自基础主题。便于针对不同API版本或配置进行微调 -->
    <style name="Theme.TaskKillTest" parent="Base.Theme.TaskKillTest">
        <!-- 主要品牌色，控制默认按钮颜色 -->
        <item name="colorPrimary">@color/green_500</item>
        <item name="colorPrimaryDark">@color/green_700</item>
        <item name="colorAccent">@color/translucent_200</item>
    </style>

</resources>