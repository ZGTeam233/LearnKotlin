<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 基础app主题 -->
    <style name="Theme.MaterialDesign" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主要品牌色，控制默认按钮颜色 -->
        <item name="colorPrimary">@color/gray_500</item>
        <item name="colorPrimaryVariant">@color/gray_700</item>
        <item name="colorPrimaryDark">@color/green_800</item>
        <item name="colorAccent">@color/green_600</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- 次要品牌色 -->
        <item name="colorSecondary">@color/translucent_200</item>
        <item name="colorSecondaryVariant">@color/translucent_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>