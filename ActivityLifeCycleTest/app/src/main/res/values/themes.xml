<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ActivityLifeCycleTest" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- 主要品牌色，控制默认按钮颜色 -->
        <item name="colorPrimary">@color/green_500</item>
        <item name="colorPrimaryVariant">@color/green_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- 次要品牌色 -->
        <item name="colorSecondary">@color/translucent_200</item>
        <item name="colorSecondaryVariant">@color/translucent_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.ActivityLifeCycleTest" parent="Base.Theme.ActivityLifeCycleTest" />
</resources>